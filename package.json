{
  "name": "@extrafemi-ai/lodestone",
  "version": "0.7.0",
  "description": "Calls AI models so your tool keeps working when a model is withdrawn, slow, rate-limited or down: failover across providers, self-updating model lists, spend limits.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obasaolorunfemi-ai/lodestone.git"
  },
  "homepage": "https://lodestone.extrafemi.com",
  "bugs": {
    "url": "https://github.com/obasaolorunfemi-ai/lodestone/issues"
  },
  "author": "Extrafemi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run typecheck:examples && npm test && npm run build",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "site": "npm run build && node site/build.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:workers": "node scripts/run-workers.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "ai",
    "anthropic",
    "circuit-breaker",
    "failover",
    "fallback",
    "gemini",
    "groq",
    "llm",
    "llm-gateway",
    "model-routing",
    "openrouter",
    "requesty"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
