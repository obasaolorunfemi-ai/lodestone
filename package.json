{
  "name": "@extrafemi-ai/lodestone",
  "version": "0.2.0",
  "description": "Calls AI models so your tool keeps working when a model is withdrawn, slow or rate-limited.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obasaolorunfemi-ai/lodestone.git"
  },
  "homepage": "https://github.com/obasaolorunfemi-ai/lodestone#readme",
  "bugs": {
    "url": "https://github.com/obasaolorunfemi-ai/lodestone/issues"
  },
  "author": "Extrafemi",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "ai",
    "llm",
    "openrouter",
    "anthropic",
    "gemini",
    "fallback",
    "model-routing"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
